# ── Required on Railway ─────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_refresh_secret_here
PORT=3001

# ── Admin Initial Bootstrap ──────────────────────────────
ADMIN_INITIAL_EMAIL=admin@campusmart.in
ADMIN_INITIAL_PASSWORD=ReplaceWithStrongPassword123!

# ── CORS ───────────────────────────────────────────────
FRONTEND_URL=https://your-app.vercel.app
ADMIN_URL=https://your-app.vercel.app

# ── Email OTP (Gmail App Password) ─────────────────────
EMAIL_USER=your@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM="CampusMart <your@gmail.com>"

# ── Google Sheets enquiry sync ─────────────────────────
# Web app URL from the Apps Script deployment for scripts/google-sheets-webhook.gs
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=replace-with-a-long-random-secret
